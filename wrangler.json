{
	"name": "vangaurd-collaboration-ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "vanguardcollaborationts.com", "custom_domain": true },
		{ "pattern": "www.vanguardcollaborationts.com", "custom_domain": true }
	],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
