---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<style>
			:root{
				--bg: ivory;
				--accent: #cc5500; /* burnt orange */
				--text: #111;
			}
			* { box-sizing: border-box; }
			body{ 
				background: var(--bg); 
				color: var(--text); 
				font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; 
				margin: 0; 
				padding: 0;
				line-height: 1.6;
			}
			main{ 
				max-width: 900px; 
				margin: 2rem auto; 
				padding: 1.5rem;
			}
			h1{ 
				color: var(--accent); 
				font-size: clamp(1.5rem, 8vw, 2.5rem);
				margin: 0.5rem 0;
			}
			h2 {
				color: var(--accent);
				font-size: clamp(1.25rem, 6vw, 1.75rem);
				margin-top: 1.5rem;
				margin-bottom: 1rem;
			}
			p {
				margin: 1rem 0;
				font-size: clamp(0.95rem, 2vw, 1.1rem);
			}
			ul {
				padding-left: 1.5rem;
				font-size: clamp(0.95rem, 2vw, 1.1rem);
			}
			li {
				margin: 0.5rem 0;
			}
			a {
				color: var(--accent);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}
			.button{ 
				display: inline-block; 
				background: var(--accent); 
				color: white; 
				padding: 1rem 1.5rem; 
				border-radius: 6px; 
				text-decoration: none; 
				border: none; 
				cursor: pointer;
				font-size: 1rem;
				font-weight: 500;
				transition: background 0.2s;
				text-align: center;
				width: 100%;
				max-width: 250px;
			}
			.button:hover {
				background: #a84500;
				text-decoration: none;
			}
			.button:active {
				transform: scale(0.98);
			}
			.secondary{ 
				background: transparent; 
				color: var(--accent); 
				border: 2px solid var(--accent); 
			}
			.secondary:hover {
				background: rgba(204, 85, 0, 0.1);
			}
			.button:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}
			.info-box{ 
				background: rgba(255, 165, 0, 0.06); 
				padding: 1rem; 
				border-radius: 8px; 
				margin: 1rem 0;
				border-left: 4px solid var(--accent);
				font-size: clamp(0.95rem, 2vw, 1rem);
			}
			.contact-row{ 
				display: flex; 
				gap: 1rem; 
				flex-wrap: wrap; 
				margin-top: 1.5rem;
				justify-content: flex-start;
			}
			/* Semantic business name styling */
			.business-name span { 
				display: block; 
				line-height: 1.1; 
			}
			.business-llc { 
				font-weight: 500; 
				font-size: 0.9em; 
				color: #666;
			}
			section {
				margin: 2rem 0;
			}
			footer {
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgba(0, 0, 0, 0.1);
				font-size: clamp(0.9rem, 2vw, 1rem);
			}
			figure {
				margin: 1.5rem 0;
			}
			figure img {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
				display: block;
			}
			/* Phone optimizations */
			@media (max-width: 768px) { 
				main { 
					margin: 1rem auto; 
					padding: 1rem;
				}
				.contact-row { 
					flex-direction: column; 
					align-items: stretch;
				}
				.button {
					width: 100%;
					max-width: none;
					padding: 0.9rem 1rem;
				}
				h1 {
					margin-top: 0;
				}
			}
			@media (max-width: 480px) {
				main {
					padding: 0.75rem;
					margin: 0.5rem auto;
				}
				.button {
					font-size: 0.95rem;
				}
				p, li, .info-box {
					font-size: 0.95rem;
				}
				figure {
					margin: 1rem 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="business-name">
				<span>Vanguard Collaboration</span>
				<span class="business-llc">Transportation Services LLC</span>
			</h1>
			<figure>
				<img src="/image_460e0a2d.png" alt="Vanguard Collaboration van" />
			</figure>
			<p class="info-box">
				📍 <strong>Roseville, MN</strong><br>
				📞 <a href="tel:+16122501613">(612) 250-1613</a>
			</p>
			<p>
				Welcome to Vanguard Collaboration Transportation Services LLC. We provide safe, punctual non-emergency medical transportation across the Twin Cities, including wheelchair-accessible and ambulatory services.
			</p>

			<section>
				<h2>Hours of Operations</h2>
				<ul>
					<li>Monday – Saturday: 7:00 AM – 7:00 PM</li>
					<li>Sunday: Closed</li>
				</ul>
			</section>

			<section>
				<h2>Request Transportation</h2>
				<p>Use the request form to submit details for future transportation. We'll get back to you to confirm availability and pricing.</p>
				<div class="contact-row">
					<a class="button" href="/request">Request Transportation</a>
					<a class="button secondary" href="tel:+16122501613">Contact Dispatch</a>
					<button class="button secondary" disabled title="Contact information coming soon">Dispatch Info (coming soon)</button>
				</div>
			</section>

			<section>
				<h2>Why Choose Us?</h2>
				<ul>
					<li>✓ Specially trained employees focused on safety and customer service</li>
					<li>✓ Reliable vehicles maintained in pristine, clean condition</li>
					<li>✓ Real-time dispatching to reduce wait times and improve reliability</li>
				</ul>
			</section>

			<footer>
				<p><strong>Questions?</strong> Call <a href="tel:+16122501613">(612) 250-1613</a> or use the request form.</p>
			</footer>
		</main>
		<Footer />
	</body>
</html>
