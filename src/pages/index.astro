---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root{
				--bg: ivory;
				--accent: #cc5500; /* burnt orange */
				--text: #111;
			}
			body{ background: var(--bg); color:var(--text); font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; margin:0; }
			main{ max-width:900px; margin:3rem auto; padding:2rem; }
			h1{ color:var(--accent); }
			.button{ display:inline-block; background:var(--accent); color:white; padding:0.75rem 1rem; border-radius:6px; text-decoration:none; border:none; cursor:pointer; }
			.secondary{ background:transparent; color:var(--accent); border:2px solid var(--accent); }
			.info-box{ background:rgba(255,165,0,0.06); padding:1rem; border-radius:8px; margin:1rem 0; }
			.contact-row{ display:flex; gap:1rem; flex-wrap:wrap; margin-top:1rem; }
			/* Semantic business name styling (replaces hard <br />) */
			.business-name span { display:block; line-height:1.05; }
			.business-llc { font-weight:500; font-size:0.95em; }
			@media (max-width:600px){ main{ margin:1rem; padding:1rem; } .contact-row{ flex-direction:column; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="business-name"><span>Vanguard Collaboration</span><span class="business-llc">Transportation Services LLC</span></h1>
			<p class="info-box">
				Base of operations: Roseville, MN • Phone: <a href="tel:+16122501613">(612) 250-1613</a>
			</p>
			<p>
				Welcome to Vanguard Collaboration Transportation Services LLC. We provide safe, punctual non‑emergency medical transportation across the Twin Cities, including wheelchair‑accessible and ambulatory door‑to‑door service. Our drivers are trained in securement and passenger assistance, and we work with brokers and managed care organizations for billing.
			</p>

			<section>
				<h2 style="color:#cc5500">Hours of Operations</h2>
				<ul>
					<li>Monday 6:00 AM-11:00 PM</li>
					<li>Tuesday 6:00 AM-11:00 PM</li>
					<li>Wednesday 6:00 AM-11:00 PM</li>
					<li>Thursday 6:00 AM-11:00 PM</li>
					<li>Friday 6:00 AM-11:00 PM</li>
					<li>Saturday 6:00 AM-11:00 PM</li>
					<li>Sunday Closed</li>
				</ul>
			</section>

			<section>
				<h2 style="color:#cc5500">Request Transportation</h2>
				<p>Use the request form to submit details for future transportation. We'll get back to you to confirm availability and pricing.</p>
				<div class="contact-row">
					<a class="button" href="/request">Request Transportation</a>
					<!-- Contact Dispatch - placeholder links. Update with live dispatch contact when available -->
					<a class="button secondary" href="tel:+16122501613">Contact Dispatch</a>
					<button class="button secondary" disabled title="Contact information coming soon">Dispatch Info (coming soon)</button>
				</div>
			</section>

			<section>
				<h2 style="color:#cc5500">Why choose us?</h2>
				<ul>
					<li>Specially trained employees focused on safety and customer service.</li>
					<li>Reliable vehicles maintained in pristine, clean condition.</li>
					<li>Real-time dispatching to reduce wait times and improve reliability.</li>
				</ul>
			</section>

			<footer style="margin-top:2rem;">
				<p>Questions? Call <a href="tel:+16122501613">(612) 250-1613</a> or use the request form.</p>
			</footer>
		</main>
		<Footer />
	</body>
</html>
