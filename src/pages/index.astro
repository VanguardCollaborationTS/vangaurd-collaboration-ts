---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE_TITLE, SITE_DESCRIPTION, PHONE_DISPLAY, PHONE_TEL, HOURS, SERVICE_AREA } from '../consts';

const services = [
	{
		icon: 'wheelchair',
		title: 'Wheelchair-Accessible Rides',
		text: 'Ramp and lift-equipped vehicles with 4-point securement, maintained to MnDOT STS standards for non-ambulatory passengers.',
	},
	{
		icon: 'car',
		title: 'Ambulatory Transportation',
		text: 'Comfortable, punctual non-emergency medical rides for clients who can transfer independently or with light assistance.',
	},
	{
		icon: 'door',
		title: 'Door-Through-Door Service',
		text: 'Drivers assist from the residence, into the vehicle, and all the way into the clinic, reception area, or appointment room.',
	},
	{
		icon: 'calendar',
		title: 'Recurring Appointments',
		text: 'Reliable standing rides for dialysis, therapy, chemotherapy, wound care, and other ongoing treatment schedules.',
	},
] as const;

const reasons = [
	{ icon: 'badge', title: 'Trained, credentialed drivers', text: 'Passenger assistance, wheelchair securement, First Aid/CPR, and full background screening.' },
	{ icon: 'sparkle', title: 'Clean, well-maintained vehicles', text: 'Hospital-grade sanitization between every trip and routine lift, ramp, and mechanical inspections.' },
	{ icon: 'clock', title: 'On-time, every time', text: 'GPS-tracked dispatch with arrival alerts so appointments start when they are supposed to.' },
	{ icon: 'heart', title: 'Dignity first', text: 'Patient, trauma-informed care for elderly riders and those living with cognitive impairment.' },
] as const;

const steps = [
	{ n: '01', title: 'Tell us about the trip', text: 'Submit the online request form or call dispatch with pickup, destination, date, time, and mobility needs.' },
	{ n: '02', title: 'We confirm the details', text: 'You receive confirmation of availability and pricing, plus any billing or authorization coordination.' },
	{ n: '03', title: 'Ride with confidence', text: 'Your driver arrives on time, assists you safely at every step, and delivers you right to your appointment.' },
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- HERO -->
	<section class="hero">
		<div class="container hero__inner">
			<div class="hero__copy">
				<p class="eyebrow">Non-Emergency Medical Transportation · Twin Cities</p>
				<h1>
					Getting you to care, <span class="hl">safely</span> and <span class="hl">on time.</span>
				</h1>
				<p class="lead">
					Wheelchair-accessible and ambulatory rides to medical appointments, dialysis, therapy, and hospital discharges across the Minneapolis–St. Paul metro — with door-through-door assistance on every trip.
				</p>
				<div class="hero__actions">
					<a href="/request" class="btn btn--primary btn--lg">
						Request a Ride
						<Icon name="arrow" />
					</a>
					<a href={`tel:${PHONE_TEL}`} class="btn btn--outline-light btn--lg">
						<Icon name="phone" />
						{PHONE_DISPLAY}
					</a>
				</div>
				<ul class="hero__badges">
					<li><Icon name="shield" /> MnDOT STS Compliant</li>
					<li><Icon name="wheelchair" /> Lift &amp; Ramp Equipped</li>
					<li><Icon name="map" /> Roseville, MN</li>
				</ul>
			</div>
			<div class="hero__media">
				<div class="hero__frame">
					<img src="/van-hero.png" alt="Vanguard Collaboration wheelchair-accessible van with rear ramp deployed outside a medical building" width="1408" height="768" loading="eager" fetchpriority="high" />
				</div>
			</div>
		</div>
	</section>

	<!-- TRUST STRIP -->
	<section class="trust">
		<div class="container trust__inner">
			<div><strong>Hennepin &amp; Ramsey</strong><span>Counties served</span></div>
			<div><strong>Door-Through-Door</strong><span>Assistance standard</span></div>
			<div><strong>4-Point Securement</strong><span>Q'Straint certified</span></div>
			<div><strong>MHCP &amp; MCO</strong><span>Billing coordination</span></div>
		</div>
	</section>

	<!-- SERVICES -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">What we do</p>
					<h2>Transportation built around medical needs</h2>
				</div>
				<a href="/services" class="btn btn--outline">All services <Icon name="arrow" /></a>
			</div>
			<div class="grid grid--4">
				{services.map((s) => (
					<article class="card">
						<div class="card__icon"><Icon name={s.icon} /></div>
						<h3>{s.title}</h3>
						<p>{s.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- WHY US -->
	<section class="section section--navy why">
		<div class="container why__inner">
			<div class="why__copy">
				<p class="eyebrow">Why Vanguard</p>
				<h2>More than a ride. A safer transition to care.</h2>
				<p class="lead">
					Standard curb-to-curb transport leaves vulnerable riders unassisted at the moments that matter most. We close that gap — from the front door to the exam room and back again.
				</p>
				<a href="/about" class="btn btn--primary">About our approach <Icon name="arrow" /></a>
			</div>
			<div class="grid grid--2 why__grid">
				{reasons.map((r) => (
					<div class="why__item">
						<div class="why__icon"><Icon name={r.icon} /></div>
						<h3>{r.title}</h3>
						<p>{r.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="section">
		<div class="container">
			<div class="section-head section-head--center">
				<div>
					<p class="eyebrow">How it works</p>
					<h2>Booking a ride is simple</h2>
				</div>
			</div>
			<ol class="steps">
				{steps.map((s) => (
					<li class="step">
						<span class="step__n">{s.n}</span>
						<h3>{s.title}</h3>
						<p>{s.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- HOURS + AREA -->
	<section class="section section--ivory-dark">
		<div class="container grid grid--2 info">
			<div class="card info__card">
				<div class="card__icon"><Icon name="clock" /></div>
				<h3>Hours of operation</h3>
				<ul class="hours">
					{HOURS.map((h) => (
						<li><span>{h.days}</span><strong>{h.time}</strong></li>
					))}
				</ul>
				<p class="muted">Extended hours and special arrangements available by request and coordinator approval.</p>
			</div>
			<div class="card card--navy info__card">
				<div class="card__icon"><Icon name="map" /></div>
				<h3>Service area</h3>
				<p>{SERVICE_AREA}.</p>
				<p>Based in Roseville, MN — serving clinics, hospitals, dialysis centers, rehabilitation facilities, adult day programs, and residences throughout the metro.</p>
				<a href="/contact" class="btn btn--primary">Contact us <Icon name="arrow" /></a>
			</div>
		</div>
	</section>

	<CtaBand />
</Layout>

<style>
	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(ellipse at 20% 0%, rgba(232, 99, 10, 0.35), transparent 50%),
			linear-gradient(160deg, var(--navy-dark) 0%, var(--navy) 60%, #22355c 100%);
		color: var(--white);
	}
	.hero::before {
		content: '';
		position: absolute;
		inset: auto -10% -30% auto;
		width: 55vw;
		height: 55vw;
		max-width: 720px;
		max-height: 720px;
		border-radius: 50%;
		border: 90px solid rgba(232, 99, 10, 0.12);
		pointer-events: none;
	}
	.hero__inner {
		position: relative;
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
	}
	.hero h1 {
		color: var(--white);
		font-size: var(--fs-hero);
		max-width: 14ch;
	}
	.hl {
		color: var(--orange-light);
		position: relative;
		white-space: nowrap;
	}
	.hero .lead {
		color: rgba(255, 255, 255, 0.82);
		max-width: 54ch;
		margin-bottom: 2rem;
	}
	.hero .eyebrow {
		color: var(--orange-light);
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 2.25rem;
	}
	.hero__badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: var(--fs-sm);
		font-weight: 700;
		color: rgba(255, 255, 255, 0.78);
	}
	.hero__badges li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.hero__badges svg {
		width: 18px;
		height: 18px;
		color: var(--orange-light);
	}

	.hero__media {
		position: relative;
	}
	.hero__frame {
		position: relative;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-lg), 0 0 0 1px rgba(255, 255, 255, 0.08);
		transform: rotate(-1.5deg);
	}
	.hero__frame::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 60%, rgba(17, 28, 51, 0.45));
		pointer-events: none;
	}
	.hero__frame img {
		width: 100%;
		height: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	/* Trust strip */
	.trust {
		background: var(--orange);
		color: var(--white);
	}
	.trust__inner {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		padding-block: 1.25rem;
	}
	.trust__inner div {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		line-height: 1.2;
	}
	.trust__inner strong {
		color: var(--white);
		font-size: var(--fs-lg);
	}
	.trust__inner span {
		font-size: var(--fs-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	/* Section heads */
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}
	.section-head h2 {
		margin-bottom: 0;
		max-width: 22ch;
	}
	.section-head--center {
		justify-content: center;
		text-align: center;
	}
	.section-head--center .eyebrow {
		justify-content: center;
	}
	.section-head--center h2 {
		margin-inline: auto;
	}

	/* Why */
	.why__inner {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.why__copy h2 {
		max-width: 16ch;
	}
	.why__copy .lead {
		margin-bottom: 2rem;
	}
	.why__item {
		padding: 1.5rem;
		border-radius: var(--radius);
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.why__item h3 {
		font-size: var(--fs-lg);
		margin-bottom: 0.4rem;
	}
	.why__item p {
		margin: 0;
		font-size: var(--fs-sm);
		color: rgba(255, 255, 255, 0.72);
	}
	.why__icon {
		display: inline-grid;
		place-items: center;
		width: 46px;
		height: 46px;
		margin-bottom: 1rem;
		border-radius: 12px;
		background: var(--orange);
		color: var(--white);
	}
	.why__icon svg {
		width: 24px;
		height: 24px;
	}

	/* Steps */
	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: step;
	}
	.step {
		position: relative;
		padding: 2rem 1.75rem 1.75rem;
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
	}
	.step__n {
		display: inline-block;
		margin-bottom: 1rem;
		font-size: 2.5rem;
		font-weight: 700;
		line-height: 1;
		color: var(--orange);
		letter-spacing: -0.04em;
	}
	.step h3 {
		font-size: var(--fs-lg);
	}
	.step p {
		margin: 0;
		color: var(--text-soft);
	}

	/* Info */
	.info__card {
		display: flex;
		flex-direction: column;
	}
	.info__card .btn {
		align-self: flex-start;
		margin-top: auto;
	}
	.hours {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
	}
	.hours li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 0;
		border-bottom: 1px dashed var(--line);
	}
	.hours li:last-child {
		border-bottom: 0;
	}

	@media (max-width: 960px) {
		.hero__inner {
			grid-template-columns: 1fr;
		}
		.hero__media {
			margin-top: 1.5rem;
		}
		.hero__frame {
			transform: none;
		}
		.trust__inner {
			grid-template-columns: repeat(2, 1fr);
		}
		.why__inner {
			grid-template-columns: 1fr;
		}
		.steps {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.section-head {
			flex-direction: column;
			align-items: flex-start;
		}
		.section-head--center {
			align-items: center;
		}
	}
</style>
