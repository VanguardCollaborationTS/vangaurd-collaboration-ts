---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { PHONE_DISPLAY, PHONE_TEL, HOURS, SERVICE_AREA } from '../consts';

const core = [
	{
		icon: 'door',
		title: 'Door-Through-Door Assistance',
		intro:
			'Standard curb-to-curb transportation leaves vulnerable riders unassisted at critical junctures. We go further: drivers assist passengers from their residences, escort them into the vehicle with proper securement, and accompany them directly into medical facilities, reception areas, or appointment rooms.',
		points: ['Eliminates transfer liability gaps', 'Reduces fall and injury risk', 'Dignity and peace of mind for passengers and families'],
	},
	{
		icon: 'wheelchair',
		title: 'Mobility Equipment & Fleet Versatility',
		intro: 'Our fleet is equipped to accommodate diverse passenger mobility profiles.',
		points: [
			'Hydraulic lift systems for non-ambulatory and wheelchair-dependent passengers',
			'Low-incline, ADA-compliant ramps for passengers with limited mobility or balance concerns',
			'4-point Q\u2019Straint certified wheelchair securement meeting MnDOT STS restraint standards',
			'Stretcher and non-ambulatory configurations for supine patient transport',
			'Climate-controlled interiors, grab bars, and comfort seating for extended trips',
		],
	},
	{
		icon: 'badge',
		title: 'Rigorous Driver Qualifications',
		intro: 'Every operator is credentialed well beyond basic commercial licensing.',
		points: [
			'Passenger Assistance Techniques (PAT/PASS) certification',
			'Current First Aid & CPR certification (AHA or Red Cross)',
			'Defensive driving and route-optimization training',
			'OSHA bloodborne pathogen and infection-control protocols',
			'Comprehensive background checks, MVR verification, and periodic recertification',
		],
	},
	{
		icon: 'calendar',
		title: 'Flexible Scheduling & Multi-Channel Booking',
		intro: 'Accessibility and ease of use are central to how we operate.',
		points: [
			`Phone-based booking with dispatch at ${PHONE_DISPLAY}`,
			'Online request form for patients, families, and case managers',
			'Recurring appointments for dialysis, therapy, counseling, oncology, and wound care',
			'Standing school-year and semester schedules for student riders',
			'Upfront, transparent pricing with no hidden fees',
		],
	},
	{
		icon: 'clock',
		title: 'On-Time Performance & GPS Tracking',
		intro: 'Medical appointments are time-sensitive. We use enterprise-grade fleet management to keep them on schedule.',
		points: [
			'Real-time vehicle tracking and accurate arrival estimates',
			'Automated SMS and phone arrival alerts',
			'Rider app for live point-A-to-point-B trip tracking (coming soon)',
			'Dynamic dispatch routing to minimize wait times',
			'Logged arrival times and performance accountability',
		],
	},
	{
		icon: 'shield',
		title: 'Compliance, Regulatory Rigor & Insurance',
		intro: 'We operate within a comprehensive regulatory and insurance framework.',
		points: [
			'Full MnDOT Special Transportation Service (STS) compliance',
			'Ramsey and Hennepin County health department standards',
			'Interior and exterior vehicle cameras recording every trip',
			'Commercial auto and general liability coverage meeting NEMT and MCO/Medicaid requirements',
			'Continuous regulatory monitoring',
		],
	},
	{
		icon: 'sparkle',
		title: 'Cleanliness & Infection Control',
		intro: 'Immunocompromised and post-surgical passengers require rigorous hygiene standards.',
		points: [
			'Hospital-grade surface disinfection between every passenger',
			'Climate and air-quality management',
			'PPE available for high-risk trips',
			'Routine mechanical, HVAC, and upholstery maintenance',
		],
	},
	{
		icon: 'globe',
		title: 'Inclusive, Specialized Passenger Care',
		intro: 'Our service model prioritizes compassionate care for vulnerable populations of every age.',
		points: [
			'Drivers trained for dementia, Alzheimer\u2019s, and cognitive impairment',
			'Child and student transport to daycare, grade school, and college for riders with mobility needs or injuries',
			'Multi-language support for non-English-speaking passengers and families',
			'Trauma-informed, dignity-centered interactions',
		],
	},
	{
		icon: 'receipt',
		title: 'Billing & Insurance Coordination',
		intro: 'We manage multi-payer billing so administrative complexity never becomes a barrier to care.',
		points: [
			'Direct MHCP and Medicaid waiver program billing (EW, DD, BI, and more)',
			'MCO network credentialing and streamlined referrals',
			'Medicare Advantage, supplemental, and commercial insurance claims',
			'Auto insurance (PIP / no-fault) and attorney-directed billing for motor vehicle accident clients',
			'Private-pay, broker, and county contract arrangements',
		],
	},
] as const;

const destinations = [
	{ icon: 'stethoscope', title: 'Medical appointments & specialist visits', text: 'Primary care, cardiology, orthopedics, oncology, rheumatology, and all specialty consultations.' },
	{ icon: 'building', title: 'Hospital discharges & transfers', text: 'Post-acute transport home or to skilled nursing, rehabilitation, or transitional care settings.' },
	{ icon: 'heart', title: 'Rehabilitation & therapy', text: 'Physical, occupational, and speech-language therapy requiring regular, predictable transport.' },
	{ icon: 'brain', title: 'Therapist & psychologist appointments', text: 'Counseling, psychology, psychiatry, and behavioral-health visits handled with discretion and consistency.' },
	{ icon: 'clock', title: 'Dialysis & ongoing treatments', text: 'Recurring rides for dialysis, chemotherapy infusions, wound care, and chronic disease management.' },
	{ icon: 'bandage', title: 'Motor vehicle accident recovery', text: 'Follow-up care, imaging, physical therapy, and chiropractic visits for MVA clients — with auto-insurance and attorney coordination.' },
	{ icon: 'school', title: 'Daycares & grade schools', text: 'Safe, dependable rides for children with mobility needs or medical conditions, on standing school-year schedules.' },
	{ icon: 'graduation', title: 'Colleges & universities', text: 'Campus transportation for students recovering from injuries or surgery who cannot drive or use transit.' },
	{ icon: 'users', title: 'Day programs, long-term care & errands', text: 'Adult day programs, senior centers, nursing homes, assisted living, memory care, and hospice — plus pharmacy, grocery, and bank trips.' },
] as const;
---

<Layout
	title="Services"
	description="Wheelchair-accessible and ambulatory NEMT, door-through-door assistance, recurring dialysis and therapy rides, and multi-payer billing coordination across the Twin Cities."
>
	<section class="page-hero">
		<div class="container">
			<p class="eyebrow">Services</p>
			<h1>Comprehensive medical transportation, done right.</h1>
			<p class="lead">
				From wheelchair-accessible rides to recurring dialysis schedules, school and campus transportation, accident-recovery care, and full billing coordination — every part of our service is built around passengers who need more than a ride.
			</p>
		</div>
	</section>

	<!-- Core services -->
	<section class="section">
		<div class="container">
			<div class="head">
				<p class="eyebrow">Core offerings</p>
				<h2>What sets Vanguard apart</h2>
			</div>
			<div class="grid grid--3">
				{core.map((s) => (
					<article class="card svc">
						<div class="card__icon"><Icon name={s.icon} /></div>
						<h3>{s.title}</h3>
						<p>{s.intro}</p>
						<ul class="check-list">
							{s.points.map((p) => <li>{p}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Destinations -->
	<section class="section section--orange">
		<div class="container">
			<div class="head">
				<p class="eyebrow">Where we take you</p>
				<h2>Destination coverage</h2>
			</div>
			<div class="grid grid--3">
				{destinations.map((d) => (
					<div class="dest">
						<div class="dest__icon"><Icon name={d.icon} /></div>
						<h3>{d.title}</h3>
						<p>{d.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Technology -->
	<section class="section">
		<div class="container">
			<div class="head">
				<p class="eyebrow">Safety &amp; technology</p>
				<h2>Visibility on every trip</h2>
			</div>
			<div class="grid tech">
				<div class="card">
					<div class="card__icon"><Icon name="smartphone" /></div>
					<h3>Live ride-tracking app <span class="tag">Coming soon</span></h3>
					<p class="svc-intro">Families, case managers, and facilities will be able to follow the vehicle from point A to point B in real time.</p>
					<ul class="check-list">
						<li>Live map of the vehicle from pickup to drop-off</li>
						<li>Push notifications when the driver is en route, arriving, and complete</li>
						<li>Shareable trip links for family members and care coordinators</li>
						<li>Trip history and receipts in one place</li>
					</ul>
				</div>
				<div class="card">
					<div class="card__icon"><Icon name="camera" /></div>
					<h3>Cameras inside &amp; outside every vehicle</h3>
					<p class="svc-intro">Interior and exterior cameras protect passengers and drivers alike.</p>
					<ul class="check-list">
						<li>Cabin camera documents securement, assistance, and passenger well-being</li>
						<li>Forward and exterior cameras record road conditions and incidents</li>
						<li>Footage supports incident review, insurance claims, and accountability</li>
						<li>Recordings are access-controlled and retained per privacy policy</li>
					</ul>
				</div>
				<div class="card">
					<div class="card__icon"><Icon name="map" /></div>
					<h3>Dispatch &amp; real-time management</h3>
					<ul class="check-list">
						<li>GPS-enabled vehicle tracking with automated passenger notifications</li>
						<li>Integrated booking across phone, online, and broker/MCO portals</li>
						<li>Real-time driver communication for updates and trip-specific instructions</li>
						<li>Mobile trip documentation, signature verification, and passenger feedback</li>
					</ul>
				</div>
				<div class="card">
					<div class="card__icon"><Icon name="shield" /></div>
					<h3>Data security &amp; privacy</h3>
					<ul class="check-list">
						<li>HIPAA-compliant data management systems</li>
						<li>Encrypted channels for sensitive passenger information</li>
						<li>Access controls limiting visibility to trip-specific details</li>
						<li>Audit logs and compliance monitoring</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Area + hours -->
	<section class="section section--ivory-dark">
		<div class="container area">
			<div>
				<p class="eyebrow">Service area &amp; hours</p>
				<h2>Serving the Twin Cities metro</h2>
				<p class="lead">{SERVICE_AREA}.</p>
				<p>Extended hours and emergency transport arrangements are available by special request and coordinator approval.</p>
			</div>
			<div class="card area__card">
				<h3>Hours of operation</h3>
				<ul class="hours">
					{HOURS.map((h) => (
						<li><span>{h.days}</span><strong>{h.time}</strong></li>
					))}
				</ul>
				<div class="area__actions">
					<a href="/request" class="btn btn--primary">Request a ride <Icon name="arrow" /></a>
					<a href={`tel:${PHONE_TEL}`} class="btn btn--outline"><Icon name="phone" /> {PHONE_DISPLAY}</a>
				</div>
				<p class="muted">Healthcare facilities and case managers: contact us directly to discuss recurring trip arrangements, bulk service agreements, and dedicated account management.</p>
			</div>
		</div>
	</section>

	<CtaBand />
</Layout>

<style>
	.head {
		margin-bottom: 2.5rem;
	}
	.head h2 {
		margin-bottom: 0;
		max-width: 24ch;
	}
	.svc p {
		color: var(--text-soft);
		font-size: var(--fs-sm);
	}
	.svc .check-list {
		font-size: var(--fs-sm);
	}
	.svc .check-list li {
		margin-bottom: 0.5rem;
	}
	.svc-intro {
		color: var(--text-soft);
	}
	.tech {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
	}
	.tag {
		display: inline-block;
		vertical-align: middle;
		margin-left: 0.4rem;
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-pill);
		background: var(--orange);
		color: var(--white);
		font-size: var(--fs-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.dest {
		padding: 1.5rem;
		border-radius: var(--radius);
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.2);
	}
	.dest__icon {
		display: inline-grid;
		place-items: center;
		width: 46px;
		height: 46px;
		margin-bottom: 1rem;
		border-radius: 12px;
		background: var(--navy);
		color: var(--white);
	}
	.dest__icon svg {
		width: 24px;
		height: 24px;
	}
	.dest h3 {
		font-size: var(--fs-lg);
		margin-bottom: 0.4rem;
	}
	.dest p {
		margin: 0;
		font-size: var(--fs-sm);
		color: rgba(255, 255, 255, 0.88);
	}

	.area {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.area h2 {
		max-width: 18ch;
	}
	.hours {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
	}
	.hours li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 0;
		border-bottom: 1px dashed var(--line);
	}
	.area__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}
	.area__card .muted {
		margin: 0;
	}
	@media (max-width: 900px) {
		.area {
			grid-template-columns: 1fr;
		}
	}
</style>
